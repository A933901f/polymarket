# =============================================================================
# REQUIRED API KEYS (In GitHub Actions, add these under Settings -> Secrets)
# =============================================================================
XAI_API_KEY=your_xai_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# OPTIONAL: Sharp Sportsbook Odds (Pinnacle / Betfair via The-Odds-API)
ODDS_API_KEY=your_odds_api_key_here

# =============================================================================
# 100,000-UNIT PAPER TRADING & STRATEGY CONFIG
# =============================================================================
PAPER_INITIAL_UNITS=100000.0
PAPER_REPORT_HOURS=4.0
BANKROLL_USD=100000.0

# Pure risk-free arbitrage minimum ROI (0.02 = 2.0% guaranteed return)
ARB_ROI_THRESHOLD=0.02
# Standard +EV mispricing threshold (set to 1.00 if you ONLY want >=100% ROI bets)
EV_ROI_THRESHOLD=0.10
# High-conviction banner threshold (1.00 = +100% ROI)
HIGH_CONVICTION_ROI_THRESHOLD=1.00
MIN_EDGE_PCT=0.03
DEVIG_METHOD=shin

# Fractional Kelly & Portfolio Exposure Caps
KELLY_FRACTION=0.25
MAX_STAKE_PCT_PER_MARKET=0.05
MAX_PORTFOLIO_EXPOSURE_PCT=0.30
MIN_MARKET_LIQUIDITY_USD=2000.0
MIN_24H_VOLUME_USD=1000.0

# =============================================================================
# GROK LIVE SEARCH & COST GUARDRAILS
# =============================================================================
GROK_MODEL=grok-4.5
GROK_ENABLE_X_SEARCH=true
GROK_ENABLE_WEB_SEARCH=true
GROK_MAX_MARKETS_PER_CYCLE=10

# =============================================================================
# RUNTIME & PERSISTENCE
# =============================================================================
DB_PATH=data/pm_engine.sqlite3
LOG_DIR=logs
SCAN_INTERVAL_S=300
HEARTBEAT_INTERVAL_S=14400
DRY_RUN=false
